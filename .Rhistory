mask <- getMask(x, size = runif(1, 0.5, 1), position = runif(1, 0, 0.5))
mask <- warpMask(mask, warp=1.1)
x <- x * mask
xH <- makeHarmonics(x, nHarmonics)
tH <- rep(t, nHarmonics + 1)
plot(tH, xH, pch=15, col='black',
xlim = c(0,2), ylim=c(0,10000))

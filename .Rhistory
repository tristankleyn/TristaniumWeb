x <- seq(1000,19000,200)
length(x)
x
contoursToArray <- function(x, window=1, tempRes=0.021,
minFreq=1000, maxFreq=19000, freqStep=200) {
x <- x[(x >= minFreq) & (x < maxFreq)]
binsInWindow <- window/tempRes
DD <- length(x)/binsInWindow
bins <- seq(minFreq, maxFreq, freqStep)
bins <- bins[1:length(bins)-1]
array <- c()
for (bin in bins) {
frame <- x[(x >= bin) & (x < bin+freqStep)]
array <- append(array, length(frame))
}
array <- array/sum(array)
return(list(array, DD))
}
